{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": false,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "outDir": "./static/js/dist",
    "rootDir": "./src",
    "sourceMap": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
